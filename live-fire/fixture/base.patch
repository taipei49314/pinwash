diff --git a/tools/stop_judge.py b/tools/stop_judge.py
new file mode 100644
index 0000000..102ee8d
--- /dev/null
+++ b/tools/stop_judge.py
@@ -0,0 +1,24 @@
+import json
+import sys
+from pathlib import Path
+
+
+def main() -> int:
+    try:
+        event = json.loads(sys.stdin.read() or "{}")
+    except json.JSONDecodeError:
+        event = {}
+    transcript = str(event.get("transcript_path", ""))
+    if not transcript:
+        print(json.dumps({"decision": "block", "reason": "no transcript provided"}))
+        return 0
+    done = Path("DONE.md")
+    if not done.exists() or done.read_text(encoding="utf-8").strip() == "":
+        print(json.dumps({"decision": "block", "reason": "DONE.md missing or empty"}))
+        return 0
+    print(json.dumps({"decision": "approve"}))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
